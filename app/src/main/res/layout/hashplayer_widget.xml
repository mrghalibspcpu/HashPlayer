<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/widget_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_search_background"
                android:paddingStart="11dp"
                android:paddingEnd="8dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/widget_search_icon"
                    android:contentDescription="Search" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Search songs or YouTube…"
                    android:textColor="#c6cbd5"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/widget_playlists"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/widget_button_background"
                android:src="@drawable/widget_playlist_icon"
                android:scaleType="center"
                android:contentDescription="Open playlists"
                android:padding="10dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_track_preview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_preview_background"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerCrop"
                android:background="@drawable/widget_button_background"
                android:contentDescription="HashPlayer" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAST PLAYED"
                    android:textColor="#8e97a9"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />
                <TextView
                    android:id="@+id/widget_track_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Nothing played yet"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/widget_track_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your last track will show here"
                    android:textColor="#aab1be"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dedicated transport row: each button targets its own action, NOT a generic
             launcher intent. This is the whole point of the widget fix. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="5">

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_button_background"
                android:src="@drawable/widget_prev_icon"
                android:scaleType="center"
                android:contentDescription="Previous"
                android:padding="8dp" />

            <ImageButton
                android:id="@+id/widget_eq"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_button_background"
                android:src="@drawable/widget_eq_icon"
                android:scaleType="center"
                android:contentDescription="Equalizer"
                android:padding="8dp" />

            <ImageButton
                android:id="@+id/widget_play_last"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_play_background"
                android:src="@drawable/widget_play_icon"
                android:scaleType="center"
                android:contentDescription="Play / Pause"
                android:padding="10dp" />

            <ImageButton
                android:id="@+id/widget_anc"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_button_background"
                android:src="@drawable/widget_anc_icon"
                android:scaleType="center"
                android:contentDescription="ANC"
                android:padding="8dp" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_background"
                android:src="@drawable/widget_next_icon"
                android:scaleType="center"
                android:contentDescription="Next"
                android:padding="8dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
